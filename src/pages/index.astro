---
import HomeComposer from '../components/content/HomeComposer.astro';
import PublicationPanel from '../components/content/PublicationPanel.astro';
import { featureSource } from '../lib/feature-source';
import HomeCover from '../components/site/HomeCover.astro';
import SiteLayout from '../layouts/SiteLayout.astro';
import { buildSEOData } from '../utils/seo';
import { buildUrl } from '../utils/url';
import { siteConfig } from '../config/site';
import { localeFromPath } from '../lib/i18n';
const vi = localeFromPath(Astro.url.pathname) === 'vi';
const posts = featureSource('posts', import.meta.env);
const rooms = [
  ['music/', vi ? 'Âm nhạc & Video' : 'Music & Video', vi ? 'Học nhạc, chơi đàn và lưu lại những giai điệu.' : 'Learning, playing, and keeping the melodies.', '01'],
  ['photos/', vi ? 'Hình ảnh' : 'Photos', vi ? 'Ảnh gia đình, cảnh đẹp và những khoảnh khắc muốn giữ lại.' : 'Family, scenery, and moments to keep.', '02'],
  ['projects/', vi ? 'Dự án' : 'Projects', vi ? 'Những thứ Hiển đang làm và đã xây dựng.' : 'Things Hien builds and experiments with.', '03'],
  ['requests/', vi ? 'Tiệm Nhờ Vả' : 'Little Help Shop', vi ? 'Gửi điều muốn nhờ, theo dõi tiến độ và kết quả.' : 'Ask for help, follow progress and results.', '04'],
  ['knowledge/', vi ? 'Góc tri thức' : 'Knowledge', vi ? 'Những điều học được, ghi lại và chia sẻ.' : 'Ideas learned, recorded, and shared.', '05'],
  ['novels/', vi ? 'Tủ truyện' : 'Novels', vi ? 'Một chút tiên hiệp, một khoảng thời gian thảnh thơi.' : 'Stories to get lost in, one chapter at a time.', '06'],
];
const seo = buildSEOData({ title: siteConfig.name, description: siteConfig.description, path: '/', kind: 'home' });
---
<SiteLayout seo={seo}>
  <div class="room home-room">
    <header class="house-hero">
      <HomeCover vi={vi} />
      {posts.source === 'api' && <HomeComposer vi={vi} epoch={posts.epoch} />}
      <div class="house-actions">
        <a class="button" href={buildUrl('guestbook/')}>{vi ? 'Để lại vài dòng cho Hiển' : 'Leave Hien a message'}</a>
        <a href={buildUrl('about/')}>{vi ? 'Làm quen với Hiển →' : 'Meet Hien →'}</a>
      </div>
    </header>
    {posts.source === 'api' && <section aria-label={vi ? 'Bài đăng của Hiển' : 'Posts by Hien'} data-pagefind-ignore>
      <h2>{vi ? 'Bài đăng của Hiển' : 'Posts by Hien'}</h2>
      <PublicationPanel vi={vi} mode="list" feature="posts" epoch={posts.epoch} homeFeed />
    </section>}
    <section class="room-grid" aria-label={vi ? 'Khám phá ngôi nhà' : 'Explore the house'}>
      {rooms.map(([path, title, description, number]) => (
        <a class="room-card" href={buildUrl(path!)}>
          <span class="eyebrow">{number}</span><h2>{title}</h2><p>{description}</p>
        </a>
      ))}
    </section>
    <aside class="house-note" aria-label={vi ? 'Một lời nhắn từ Hiển' : 'A note from Hien'}>
      <p class="eyebrow">{vi ? 'TIỆM NHỜ VẢ — TÍCH CÔNG ĐỨC' : 'A LITTLE HELP, A LITTLE GOOD KARMA'}</p>
      <h2>{vi ? '“Việc của bạn, công đức của tui!”' : '“Your request, my good karma!”'}</h2>
      <p>{vi ? 'Có ý tưởng, lời nhắn hay điều muốn nhờ? Ghé Tiệm Nhờ Vả, Hiển sẽ xem xét khi có thời gian.' : 'An idea, a note, or something you need help with? Visit the Little Help Shop; Hien will review it when he can.'}</p>
      <p><a href={buildUrl('requests/')}>{vi ? 'Ghé Tiệm Nhờ Vả →' : 'Visit the Little Help Shop →'}</a></p>
    </aside>
  </div>
</SiteLayout>
<style>
  .home-room { padding-top: 1.25rem; }
  .house-hero { padding-bottom: 2.5rem; }
  .house-hero > :is(p, h1, .house-actions) { max-width: 42rem; }
  .house-hero h1 { font-size: clamp(2.75rem,7vw,4.75rem); font-weight: 800; letter-spacing: -0.055em; line-height: 1.1; margin: 0.5rem 0 1.25rem; }
  .house-hero h1 span { color: #0f766e; }
  .house-lead { font-size: 1.4rem; color: #134e4a; font-weight: 600; }
  .house-actions { display: flex; align-items: center; flex-wrap: wrap; gap: 1.25rem; margin-top: 1.5rem; }
  .house-note { margin-top: 2rem; padding: 1.5rem; background: #f0fdfa; border-left: 3px solid #0f766e; border-radius: 0 0.75rem 0.75rem 0; }
  .house-note h2 { font-size: 1.25rem; font-weight: 600; }
</style>
