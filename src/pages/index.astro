---
import HomeComposer from '../components/content/HomeComposer.astro';
import ApiComments from '../components/comments/ApiComments.astro';
import PageComments from '../components/site/PageComments.astro';
import { commentSource } from '../lib/comment-source';
import PublicationPanel from '../components/content/PublicationPanel.astro';
import { featureSource } from '../lib/feature-source';
import HomeCover from '../components/site/HomeCover.astro';
import SiteLayout from '../layouts/SiteLayout.astro';
import { buildSEOData } from '../utils/seo';
import { buildUrl } from '../utils/url';
import { siteConfig } from '../config/site';
import { localeFromPath } from '../lib/i18n';
const vi = localeFromPath(Astro.url.pathname) === 'vi';
const posts = featureSource('posts', import.meta.env);
const comments = commentSource(import.meta.env);
const seo = buildSEOData({ title: siteConfig.name, description: siteConfig.description, path: '/', kind: 'home' });
---
<SiteLayout seo={seo} showPageComments={false}>
  <div class="room home-room">
    <header class="house-hero">
      <HomeCover vi={vi} />
      {posts.source === 'api' && <HomeComposer vi={vi} epoch={posts.epoch} />}

    </header>
    {posts.source === 'api' && <section aria-label={vi ? 'Bài đăng của Hiển' : 'Posts by Hien'} data-pagefind-ignore>
      <PublicationPanel vi={vi} mode="list" feature="posts" epoch={posts.epoch} homeFeed />
    </section>}
      <div class="house-actions">
        {comments.source === 'api' ? <button class="button" type="button" data-open-home-comments aria-controls="home-comments-composer" aria-expanded="false">{vi ? 'Để lại vài dòng cho Hiển' : 'Leave Hien a message'}</button> : <a class="button" href={buildUrl('guestbook/')}>{vi ? 'Để lại vài dòng cho Hiển' : 'Leave Hien a message'}</a>}
        <a href={buildUrl('about/')}>{vi ? 'Làm quen với Hiển →' : 'Meet Hien →'}</a>
      </div>
    {comments.source === 'api' ? <ApiComments contextPath={buildUrl('/')} vi={vi} epoch={comments.epoch} home /> : <PageComments title={seo.title} />}
  </div>
</SiteLayout>
<style>
  .home-room { padding-top: 1.25rem; }
  .house-hero { padding-bottom: .25rem; }
  .house-actions { display: flex; align-items: center; flex-wrap: wrap; gap: 1.25rem; margin-top: 1.5rem; }
  .house-actions { max-width: 48rem; }
</style>
