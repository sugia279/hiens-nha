---
import {featureSource} from '../../lib/feature-source';
import PublicationPanel from '../../components/content/PublicationPanel.astro';
import {localeFromPath} from '../../lib/i18n';
import { buildUrl } from '../../utils/url';
import { sharedKnowledge } from '../../lib/shared-knowledge';
import ListingLayout from '../../layouts/ListingLayout.astro';
import SeriesSummary from '../../components/cards/SeriesSummary.astro';
import { getPublishedSeries, toSeriesSummary } from '../../lib/content/queries';
import { sortEntries } from '../../lib/content/sort';
import { buildSEOData } from '../../utils/seo';

const source=featureSource('posts',import.meta.env),vi=localeFromPath(Astro.url.pathname)==='vi';
const allSeries = await getPublishedSeries();
const sorted = sortEntries(allSeries, 'newest');
const summaries = sorted.map(toSeriesSummary);

const seo = buildSEOData({
  title: 'Series',
  description: 'Curated ordered learning paths across topics.',
  path: 'series/',
  kind: 'listing',
});
---

<ListingLayout seo={seo} title="Series" description="Curated ordered learning paths across topics." itemCount={summaries.length + (source.source==='git'?new Set(sharedKnowledge.map(item => item.series).filter(Boolean)).size:0)} activeCollection="series">
  <p slot="filters" hidden={source.source!=='api'}><a href={buildUrl(`${vi?'':'en/'}knowledge/#shared-knowledge`)}>{vi?'Xem các chuỗi bài chia sẻ hiện tại':'Browse current shared series'}</a></p>
  {source.source==='git'&&[...new Set(sharedKnowledge.map(item => item.series).filter(Boolean))].map(name => <a class="room-card" href={buildUrl('knowledge/#shared-knowledge')}><h2 data-original-content>{name}</h2><p>{sharedKnowledge.filter(item => item.series === name).length} bài / posts</p></a>)}
  {summaries.map((s) => <SeriesSummary series={s} />)}
  {source.source==='api' && <section><h2>{vi?'Bài viết theo chuỗi':'Series posts'}</h2><PublicationPanel vi={vi} mode="list" feature="posts" epoch={source.epoch} categoryId="series" /></section>}
</ListingLayout>
