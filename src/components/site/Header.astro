---
/**
 * Header — topbar and collapsible sidebar composition.
 * Registry: Site component, M7.
 */
import SiteIdentity from './SiteIdentity.astro';
import PrimaryNavigation from './PrimaryNavigation.astro';
import MobileNavigation from './MobileNavigation.astro';
import { novelGenres, genreForNovel } from '../../config/novels';
import { primaryNavigation } from '../../config/navigation';
import { buildUrl, entryUrl } from '../../utils/url';
import { getPublishedArticles } from '../../lib/content/queries';
import { getArticleFolders } from '../../lib/content/article-folders';
import { localeFromPath, localeUrl } from '../../lib/i18n';

interface Props {
  currentPath?: string;
}

const { currentPath = '' } = Astro.props;
const searchUrl = buildUrl('/search/');
const locale = localeFromPath(currentPath);
const notFound = currentPath.includes('/404');
const folders = getArticleFolders(await getPublishedArticles()).filter((folder) => folder.isNovel);
const decodedPath = decodeURI(localeUrl(currentPath, 'vi'));
const navigation = primaryNavigation.map((item) => item.href === '/novels/' ? {
  ...item,
  children: [
    ...novelGenres.map((genre) => ({
      label: genre.label, href: `/novels/genres/${genre.id}/`,
      children: folders.filter((folder) => genreForNovel(folder.id) === genre.id).map((folder) => ({
        label: folder.title, href: `/novels/${folder.id}/`,
        matchPattern: folder.articles.some((article) => decodedPath === entryUrl('articles', article.id)) ? localeUrl(currentPath, 'vi') : undefined,
      })),
    })),
    ...folders.filter((folder) => !genreForNovel(folder.id)).map((folder) => ({ label: folder.title, href: `/novels/${folder.id}/` })),
  ],
} : item);
---

<header class="topbar">
  <button
    id="sidebar-toggle"
    class="topbar__hamburger"
    aria-label="Toggle navigation"
    aria-controls="sidebar"
    aria-expanded="true"
    type="button"
  >
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true">
      <line x1="3" y1="6" x2="21" y2="6" />
      <line x1="3" y1="12" x2="21" y2="12" />
      <line x1="3" y1="18" x2="21" y2="18" />
    </svg>
  </button>

  <SiteIdentity />

  <form action={searchUrl} method="get" role="search" class="topbar__search" aria-label="Search the knowledge garden">
    <div class="topbar__search-wrap">
      <svg class="topbar__search-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
        <circle cx="11" cy="11" r="8" />
        <line x1="21" y1="21" x2="16.65" y2="16.65" />
      </svg>
      <input
        id="topbar-search-input"
        type="search"
        name="q"
        placeholder="Search articles, notes, projects, topics…"
        class="topbar__search-input"
        autocomplete="off"
        spellcheck="false"
      />
      <button type="submit" class="topbar__search-submit" aria-label="Submit search">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true">
          <polyline points="9 18 15 12 9 6" />
        </svg>
      </button>
    </div>
  </form>
  <nav class="language-switch" aria-label="Language">
    <a href={notFound ? buildUrl('404.html') : localeUrl(currentPath, 'vi')} hreflang="vi" lang="vi" aria-current={locale === 'vi' ? 'true' : undefined} data-locale-link>VI</a>
    <a href={notFound ? buildUrl('en/404/') : localeUrl(currentPath, 'en')} hreflang="en" lang="en" aria-current={locale === 'en' ? 'true' : undefined} data-locale-link>EN</a>
  </nav>
</header>

<aside id="sidebar" class="sidebar" aria-label="Main navigation">
  <div class="sidebar__desktop-nav">
    <PrimaryNavigation items={navigation} currentPath={currentPath} />
  </div>
  <MobileNavigation items={navigation} currentPath={currentPath} />
</aside>
<div class="sidebar-backdrop" aria-hidden="true"></div>

<script>
import { initSidebar } from './sidebar';
import { onPageMount } from '../../lib/page-lifecycle';
onPageMount((page) => {

  initSidebar(page.signal);
  document.querySelectorAll<HTMLAnchorElement>('a[data-locale-link]').forEach((link) => {
    const target = new URL(link.href);
    target.search = window.location.search;
    target.hash = window.location.hash;
    link.href = target.toString();
  });



});
</script>

<style>
  .language-switch { grid-column: 3 / 5; justify-self: end; display: flex; gap: 0.25rem; margin-left: auto; flex-shrink: 0; }
  .language-switch a { color: #cbd5e1; padding: 0.4rem; border-radius: 0.25rem; font-size: 0.8rem; text-decoration: none; }
  .language-switch a[aria-current] { background: #334155; color: #fff; font-weight: 700; }
  .topbar {
    grid-area: topbar;
    position: sticky;
    top: 0;
    z-index: 100;
    display: grid;
    grid-template-columns: 36px minmax(0, 1fr) minmax(0, 1fr) 36px;
    align-items: center;
    gap: 0.75rem;
    height: var(--topbar-h);
    padding: 0 1.25rem;
    background: var(--topbar-bg);
    border-bottom: 1px solid rgba(255, 255, 255, 0.07);
  }

  .topbar__hamburger,
  .topbar__search-submit {
    display: flex;
    align-items: center;
    justify-content: center;
    border: none;
    cursor: pointer;
    padding: 0;
  }

  .topbar__hamburger {
    flex-shrink: 0;
    width: 36px;
    height: 36px;
    background: transparent;
    color: var(--topbar-text);
    border-radius: 0.375rem;
  }
  .topbar__hamburger svg { width: 20px; height: 20px; }
  .topbar__hamburger:hover { background: rgba(255, 255, 255, 0.08); }
  .topbar__hamburger:focus-visible,
  .topbar__search-submit:focus-visible {
    outline: 2px solid var(--sidebar-accent);
    outline-offset: 2px;
  }

  .topbar__search { position: absolute; left: 50%; transform: translateX(-50%); width: min(44%, 600px); min-width: 0; }
  .topbar__search-wrap { position: relative; display: flex; align-items: center; }
  .topbar__search-icon {
    position: absolute;
    left: 0.625rem;
    width: 16px;
    height: 16px;
    color: #64748b;
    pointer-events: none;
  }
  .topbar__search-input {
    width: 100%;
    padding: 0.45rem 2.5rem 0.45rem 2.25rem;
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 0.5rem;
    color: var(--topbar-text);
    font-size: 0.9375rem;
    outline: none;
  }
  .topbar__search-input::placeholder { color: #64748b; }
  .topbar__search-input:focus {
    border-color: var(--sidebar-accent);
    background: rgba(255, 255, 255, 0.1);
    box-shadow: 0 0 0 2px rgba(59, 130, 246, 0.25);
  }
  .topbar__search-submit {
    position: absolute;
    right: 0.375rem;
    width: 28px;
    height: 28px;
    background: rgba(255, 255, 255, 0.1);
    color: #94a3b8;
    border-radius: 0.25rem;
  }
  .topbar__search-submit:hover { background: rgba(255, 255, 255, 0.18); color: #e2e8f0; }
  .topbar__search-submit svg { width: 14px; height: 14px; }

  .sidebar {
    grid-area: sidebar;
    min-width: 0;
    overflow-y: auto;
    background: var(--sidebar-bg);
    border-right: 1px solid rgba(255, 255, 255, 0.06);
  }
  .sidebar__desktop-nav { display: block; }
  .sidebar-backdrop { display: none; }

  @media (max-width: 639px) { .topbar__search { width: calc(100% - 180px); } }
  @media (max-width: 767px) {
    .topbar { padding-inline: .75rem; }
    .sidebar {
      position: fixed;
      top: var(--topbar-h);
      bottom: 0;
      left: 0;
      z-index: 200;
      width: var(--sidebar-w);
      transform: translateX(-100%);
      transition: transform var(--transition);
    }
    :global(.app-shell:not(.is-collapsed)) .sidebar { transform: translateX(0); }
    .sidebar__desktop-nav { display: none; }
    .sidebar-backdrop { position: fixed; inset: var(--topbar-h) 0 0; z-index: 150; background: rgba(2, 6, 23, .48); }
    :global(.app-shell:not(.is-collapsed)) .sidebar-backdrop { display: block; }
  }
</style>
