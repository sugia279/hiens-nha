---
/**
 * SiteIdentity — site name/logo linking to the home page.
 * Registry: Site component, M7.
 */
import { siteConfig } from '../../config/site';
import { buildUrl } from '../../utils/url';

const homeUrl = buildUrl('/');
---

<a href={homeUrl} class="site-identity" aria-label={`${siteConfig.name} — home`}>
  <svg class="site-identity__logo" viewBox="0 0 64 64" aria-hidden="true" focusable="false">
    <circle cx="32" cy="32" r="29" fill="#134e4a" stroke="#99f6e4" stroke-width="2" />
    <path d="M18 20V44M18 32H31M31 44V20L46 44V20" fill="none" stroke="#f0fdfa" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round" />
  </svg>
  <span class="site-identity__name">{siteConfig.name}</span>
</a>

<style>
  .site-identity {
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }
  .site-identity__logo { width: 32px; height: 32px; flex-shrink: 0; }
  .site-identity__name {
    font-weight: 700;
    font-size: 1rem;
    color: var(--topbar-text);
    white-space: nowrap;
  }
  .site-identity:hover .site-identity__name { color: #bfdbfe; }
  .site-identity:focus-visible {
    outline: 2px solid var(--sidebar-accent);
    outline-offset: 3px;
    border-radius: 3px;
  }
  @media (max-width: 639px) { .site-identity__name { display: none; } }
</style>
