---
import { buildUrl } from '../../utils/url';
import { coverLayouts } from '../../lib/cover-layout';
import '../site/cover-layout.css';
import { homeAuthorName } from '../../config/home-feed';
interface Props { vi: boolean; epoch: number }
const { vi, epoch } = Astro.props;
const avatar=buildUrl('resume/SuDuyHien_Profile.png');
---
<div class="home-composer" data-home-composer data-social-composer data-locale={vi?'vi':'en'} data-epoch={epoch} data-pagefind-ignore>
 <div class="thought-bar">
  <img data-shared-avatar src={avatar} width="48" height="48" alt={vi?'Ảnh đại diện của Hiển':'Hien’s avatar'} />
  <textarea data-home-thought readonly rows="1" disabled placeholder={vi?'Nói ra những gì bạn muốn':'Say what’s on your mind'} aria-label={vi?'Viết bài mới':'Write a new post'} aria-describedby="home-composer-note"></textarea>
 </div>
 <p id="home-composer-note" data-composer-note>{vi?'Chủ nhà đăng nhập để viết bài; bạn có thể bình luận dưới bài đăng.':'The owner can sign in to write; visitors can comment on posts.'} <button type="button" data-inline-sign-in>{vi?'Đăng nhập':'Sign in'}</button></p>
 <dialog class="status-dialog" data-status-dialog aria-labelledby="status-dialog-title">
  <header class="status-heading"><button type="button" data-status-close aria-label={vi?'Đóng hộp viết bài':'Close post dialog'}>×</button><h2 id="status-dialog-title">{vi?'Bài viết mới':'New post'}</h2><span></span></header>
  <form data-status-form>
   <div class="status-scroll">
    <div class="status-author"><img data-shared-avatar src={avatar} width="48" height="48" alt=""/><div><strong>{homeAuthorName}</strong><small>{vi?'Một điều muốn chia sẻ hôm nay':'Something to share today'}</small></div></div>
    <div class="status-tags" role="group" aria-label={vi?'Thêm vào bài viết':'Add to your post'}>
     <button type="button" data-social-toggle="people"><span aria-hidden="true">👥</span>{vi?'Người':'People'}</button>
     <button type="button" data-social-toggle="location"><span aria-hidden="true">📍</span>{vi?'Vị trí':'Place'}</button>
     <button type="button" data-social-toggle="feeling"><span aria-hidden="true">☺</span>{vi?'Cảm xúc':'Feeling'}</button>
    </div>
    <div class="status-details">
     <label data-social-field="people" hidden>{vi?'Cùng với ai? (cách nhau bằng dấu phẩy)':'With whom? (comma separated)'}<input type="text" name="people" maxlength="609" placeholder={vi?'Nhập tên người bạn muốn nhắc đến':'Names you want to mention'}/></label>
     <label data-social-field="location" hidden>{vi?'Bạn đang ở đâu?':'Where are you?'}<input type="text" name="location" maxlength="120" placeholder={vi?'Nhập địa điểm':'Enter a place'}/></label>
     <label data-social-field="feeling" hidden>{vi?'Bạn cảm thấy thế nào?':'How are you feeling?'}<select name="feeling"><option value="">{vi?'Chọn cảm xúc':'Choose a feeling'}</option><option value="happy">😊 {vi?'Vui vẻ':'Happy'}</option><option value="grateful">🙏 {vi?'Biết ơn':'Grateful'}</option><option value="loved">🥰 {vi?'Yêu thương':'Loved'}</option><option value="excited">🤩 {vi?'Hào hứng':'Excited'}</option><option value="thoughtful">🤔 {vi?'Suy tư':'Thoughtful'}</option><option value="sad">😔 {vi?'Buồn':'Sad'}</option></select></label>
    </div>
    <textarea class="status-body" name="body" required maxlength="12000" placeholder={vi?'Bạn đang nghĩ gì?':'What’s on your mind?'} aria-label={vi?'Nội dung bài viết':'Post text'}></textarea>
    <section class="status-media-area" aria-label={vi?'Ảnh và video đính kèm':'Attached photos and videos'}>
     <div class="status-media-options"><label>{vi?'Bố cục':'Layout'}<select name="layout" data-status-layout>{coverLayouts.map(l=><option value={l.id} data-count={l.count}>{vi?l.vi:l.en}</option>)}</select></label><label>{vi?'Kiểu khung':'Frame'}<select name="frame"><option value="rounded">{vi?'Bo góc':'Rounded'}</option><option value="square">{vi?'Vuông':'Square'}</option><option value="polaroid">Polaroid</option></select></label></div>
     <p data-media-empty>{vi?'Ảnh và video anh chọn sẽ hiện ở đây. Nhấn Thư viện ảnh để thêm.':'Your photos and videos will appear here. Choose Photo library to add media.'}</p>
     <div class="status-photos profile-photo-grid" data-status-photos data-layout="auto" data-frame="rounded" data-photo-count="0"></div>
    </section>
   </div>
   <footer class="status-footer">
    <div class="status-tools"><button class="library-button" type="button" data-status-library><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="4"/><circle cx="8" cy="8" r="1.5"/><path d="m3 17 6-6 4 4 3-3 5 5"/></svg>{vi?'Thư viện ảnh':'Photo library'}</button><span>{vi?'Tối đa 4 ảnh/video · Video MP4, WebM ≤20 MB':'Up to 4 photos/videos · MP4, WebM ≤20 MB'}</span></div>
    <input data-status-files type="file" accept="image/jpeg,image/png,image/webp,video/mp4,video/webm" multiple hidden aria-label={vi?'Chọn ảnh':'Choose photos'}/>
    <p class="status-message" data-status-message role="status" aria-live="polite"></p>
    <div class="status-submit-row"><label class="status-visibility"><span aria-hidden="true">◉</span><select name="visibility" aria-label={vi?'Ai được xem bài viết':'Who can see this post'}><option value="public">{vi?'Công khai':'Public'}</option><option value="hidden">{vi?'Chỉ mình tôi':'Only me'}</option></select></label><span data-status-count>0 / 12000</span><button class="status-submit" type="submit" disabled>{vi?'Đăng bài':'Post'}</button></div>
   </footer>
  </form>
 </dialog>
</div>
<script src="./social-entry.ts"></script>
<script src="../account/inline-sign-in.ts"></script>
<style>
 .home-composer{margin:1.25rem 0;max-width:48rem}.thought-bar{display:flex;align-items:center;gap:.75rem;padding:.85rem;border:1px solid #e2e8f0;border-radius:1rem;background:#fff}.thought-bar img{width:48px;height:48px;border-radius:50%;object-fit:cover;flex-shrink:0}.thought-bar textarea{flex:1;min-width:0;resize:none;border:0;border-radius:2rem;padding:.8rem 1rem;background:#f0f2f5;font:inherit;line-height:1.5;cursor:pointer}.thought-bar textarea:disabled{opacity:1;cursor:default}.thought-bar textarea:focus-visible{outline:2px solid #0f766e;outline-offset:3px}.home-composer>p{margin:.5rem 1rem;font-size:.875rem}
 .status-dialog{width:min(94vw,40rem);max-height:90dvh;height:min(46rem,90dvh);padding:0;margin:auto;border:1px solid #e2e8f0;border-radius:1.25rem;background:white;color:#172d2a;box-shadow:0 24px 80px #0f172a33;overflow:hidden}.status-dialog[open]{display:flex;flex-direction:column}.status-dialog::backdrop{background:#0f172a80;backdrop-filter:blur(3px)}.status-dialog [hidden]{display:none!important}.status-heading{display:grid;grid-template-columns:3rem 1fr 3rem;align-items:center;padding:.75rem;border-bottom:1px solid #e2e8f0;flex-shrink:0}.status-heading h2{font-size:1.125rem;font-weight:700;text-align:center;margin:0}.status-heading button{font-size:1.9rem;border:0;background:transparent;line-height:1;border-radius:50%;width:2.5rem;height:2.5rem;cursor:pointer}
 .status-dialog form{display:flex;flex-direction:column;flex:1;min-height:0}.status-scroll{overflow-y:auto;flex:1;padding:1.25rem;display:flex;flex-direction:column;gap:1rem}.status-author{display:flex;gap:.75rem;align-items:center}.status-author img{width:48px;height:48px;border-radius:50%;object-fit:cover}.status-author strong{display:block;font-size:1rem}.status-author small{display:block;font-size:.875rem;color:#64748b;margin-top:.15rem}.status-tags{display:flex;gap:.5rem;flex-wrap:wrap}.status-tags button{display:flex;gap:.4rem;align-items:center;padding:.4rem .75rem;background:#f8fafc;border:1px solid #dbe4e5;border-radius:2rem;font-size:.875rem;cursor:pointer}.status-tags button[aria-expanded="true"]{background:#e5f5ef;border-color:#9bcbbb}.status-tags span{font-size:1.25rem;line-height:1}.status-details:empty{display:none}.status-details label{display:grid;gap:.4rem;font-size:.875rem;margin-bottom:.75rem}.status-details input,.status-details select{padding:.65rem;border:1px solid #cbd5e1;border-radius:.65rem;width:100%;background:#fff}.status-body{display:block;min-height:6rem;height:7rem;flex:none;resize:none;border:0;padding:.1rem 0;font:inherit;font-size:1.2rem;line-height:1.65;color:#172d2a;width:100%}.status-body::placeholder{color:#718078}.status-body:focus{outline:none}.status-body:focus-visible{outline:2px solid #99c9b8;outline-offset:4px;border-radius:.25rem}
 .status-media-area{container-type:inline-size;container-name:home-cover;border:1px solid #dbe4e5;border-radius:1rem;padding:.75rem;background:#f8faf9}.status-media-options{display:flex;gap:.6rem;margin-bottom:.75rem;flex-wrap:wrap}.status-media-options label{display:grid;gap:.25rem;font-size:.8rem;flex:1;min-width:7rem}.status-media-options select{width:100%;min-width:0;border:1px solid #cbd5e1;border-radius:.5rem;background:#fff;padding:.5rem}.status-media-area>p{padding:1.2rem .4rem;text-align:center;color:#64748b;font-size:.9rem}.status-photos:empty{display:none}.status-photos :global(.preview-photo){position:relative}.status-photos :global(video){display:block;width:100%;height:100%;object-fit:cover}.status-photos :global(button){position:absolute;right:.35rem;top:.35rem;background:#fff;border:1px solid #cbd5e1;border-radius:50%;width:2rem;height:2rem;font-size:1.3rem;cursor:pointer;z-index:1}
 .status-footer{padding:1rem 1.25rem;border-top:1px solid #edf0f2;background:#fff;flex-shrink:0}.status-tools{display:flex;gap:.85rem;align-items:center}.library-button{display:flex;align-items:center;gap:.5rem;padding:.7rem 1rem;border:1px solid #dbe4e5;border-radius:.75rem;background:#fff;box-shadow:0 2px 6px #0f172a0a;cursor:pointer;font-weight:600;font-size:.875rem}.status-tools>span{font-size:.8rem;color:#64748b}.status-message{font-size:.875rem;margin:.65rem 0;line-height:1.4}.status-message:empty{margin:0}.status-submit-row{display:flex;gap:.75rem;align-items:center;margin-top:1rem}.status-visibility{display:flex;gap:.25rem;align-items:center;background:#f1f5f3;border-radius:2rem;padding:.4rem .7rem}.status-visibility select{background:transparent;border:0;font-size:.875rem;max-width:9rem}.status-submit-row>span{font-size:.75rem;color:#64748b;margin-left:auto}.status-submit{border:0;border-radius:.7rem;background:#0f766e;color:white;font-weight:700;padding:.7rem 1.25rem;cursor:pointer}.status-submit:disabled{background:#e2e8f0;color:#74817c;cursor:default}
 @media(max-width:600px){.status-dialog{width:100%;max-width:none;height:100dvh;max-height:100dvh;border:0;border-radius:0}.status-scroll{padding:1rem}.status-footer{padding:.85rem 1rem max(.85rem,env(safe-area-inset-bottom))}.status-tools>span{font-size:.75rem}.status-body{font-size:1.125rem;min-height:5rem;height:6rem}.status-submit-row{gap:.5rem}.thought-bar{padding:.75rem}.thought-bar img{width:40px;height:40px}.thought-bar textarea{font-size:.9rem;padding:.7rem}}
</style>
