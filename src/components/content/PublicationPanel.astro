---
import {legacyPublicationAnchors} from '../../lib/legacy-publication-aliases.server';
import AuthPanel from '../account/AuthPanel.astro';
import SignInDialogTemplate from '../account/SignInDialogTemplate.astro';
import CategoryPicker from './CategoryPicker.astro';
import ApiComments from '../comments/ApiComments.astro';
import { getBase, buildUrl } from '../../utils/url';
interface Props {
  vi: boolean;
  mode: 'editor' | 'reader' | 'list' | 'admin';
  feature?: 'posts' | 'media';
  epoch?: number;
  ownerOnly?: boolean;
  homeFeed?: boolean;
  compactComposer?: boolean;
  categoryId?: string;
}
const { vi, mode, feature = 'posts', epoch = 1, ownerOnly = false, homeFeed = false, compactComposer = false, categoryId } = Astro.props;
---

<section
  class="publication-panel"
  hidden={ownerOnly}
  data-compact-composer={compactComposer ? "true" : undefined}
  data-owner-only={ownerOnly ? "true" : undefined}
  data-home-feed={homeFeed ? "true" : undefined}
  data-publications
  data-mode={mode}
  data-feature={feature}
  data-locale={vi ? 'vi' : 'en'}
  data-base={getBase()}
  data-epoch={epoch}
  data-filter-category={categoryId}
  data-legacy-anchors={mode==='list'&&feature==='posts'?JSON.stringify(legacyPublicationAnchors()):undefined}
  data-pagefind-ignore
>
  {(mode === 'editor' || mode === 'reader') && <AuthPanel vi={vi} />}
  <p data-feature-status role="status" aria-live="polite">
    {vi ? 'Chức năng API chưa bật.' : 'API feature is not enabled.'}
  </p>
  <div class="toolbar">
    {
      mode === 'editor' && (
        <div>
            <label>
              {vi ? 'Loại nội dung' : 'Content type'}
              <select data-feature-select>
                  <option value="posts">{vi ? 'Bài viết' : 'Posts'}</option>
                  <option value="media">Music &amp; Video</option>
              </select>
            </label>
            <button type="button" data-new>
              {vi ? 'Tạo mới' : 'New'}
            </button>
        </div>
      )
    }
    {
      mode === 'admin' && (
        <div>
            <label>
              {vi ? 'Loại' : 'Type'}
              <select data-feature-select>
                  <option value="posts">{vi ? 'Bài viết' : 'Posts'}</option>
                  <option value="media">Media</option>
              </select>
            </label>
            <label>
              {vi ? 'Hàng đợi' : 'Queue'}
              <select data-view>
                  <option value="pending">
                    {vi ? 'Chờ duyệt' : 'Pending'}
                  </option>
                  <option value="all">{vi ? 'Tất cả' : 'All'}</option>
              </select>
            </label>
        </div>
      )
    }
    <button type="button" data-feature-refresh
      >{vi ? 'Tải lại' : 'Refresh'}</button
    >
    {
      mode === 'list' && !homeFeed && (
        <div>
        <a href={buildUrl(`${vi ? '' : 'en/'}account/content/`)}>
          {vi ? 'Viết bài / gửi link' : 'Write / share a link'}
        </a>
        </div>
      )
    }
  </div>
  {
    mode === 'editor' && (
        <div>
      <form data-publication-form hidden>
        <label>
          {vi ? 'Tiêu đề' : 'Title'}
          <input type="text" name="title" required maxlength="120" />
        </label>
        <label data-post-field>
          {vi ? 'Hình thức' : 'Format'}
          <select name="kind">
              <option value="article">{vi ? 'Bài viết' : 'Article'}</option>
              <option value="note">{vi ? 'Ghi chú' : 'Note'}</option>
              <option value="poem">{vi ? 'Thơ' : 'Poem'}</option>
          </select>
        </label>
        <label data-post-field>
          {vi
            ? 'Nội dung Markdown/văn bản (tối đa 12.000 ký tự)'
            : 'Markdown/text (up to 12,000 characters)'}
          <textarea name="body" rows="10" maxlength="12000" ></textarea>
        </label>
        <div data-post-field><CategoryPicker scope="posts" name="category" id="post-category" vi={vi} value="Dự Án" label={vi ? 'Loại bài viết' : 'Writing category'} /></div>
        <label data-post-field>
          {vi ? 'Chuỗi bài (tùy chọn)' : 'Series (optional)'}
          <input type="text" name="series" maxlength="100" />
        </label>
        <label data-post-field>
          {vi ? 'Thứ tự trong chuỗi' : 'Series position'}
          <input name="order" type="number" min="1" max="100000" value="1" />
        </label>
        <label data-media-field hidden>
          URL
          <input name="url" type="url" maxlength="2048" />
        </label>
        <label data-media-field hidden>
          {vi ? 'Loại media' : 'Media category'}
          <select name="mediaCategory">
              <option value="music">Music</option>
              <option value="video">Video</option>
          </select>
        </label>
        <label data-media-field hidden>
          {vi ? 'Mô tả' : 'Description'}
          <textarea name="description" rows="4" maxlength="1500" ></textarea>
        </label>
        <div data-media-field hidden><CategoryPicker scope="media" name="mediaFolder" id="media-folder" vi={vi} value="Video yêu thích" label={vi ? 'Loại Video' : 'Video category'} /></div>
        <label>
          Tags
          <input type="text" name="tags" value="chia-se" maxlength="500" />
        </label>
        {ownerOnly && <button data-publish-home type="button">{vi ? "Đăng bài" : "Publish post"}</button>}
        <p>
          {vi
            ? 'Bản nháp hợp lệ tự lưu sau khi dừng nhập. Lưu nháp không có nghĩa công khai; bấm Gửi duyệt khi sẵn sàng.'
            : 'Valid drafts autosave after typing pauses. Saving does not publish; submit for review when ready.'}
        </p>
          <button type="submit">{vi ? 'Lưu nháp' : 'Save draft'}</button>
          <button data-submit-review type="button">
            {vi ? 'Gửi duyệt' : 'Submit for review'}
          </button>
        <button data-delete-publication type="button" hidden>
          {vi ? 'Xóa nội dung của tôi' : 'Delete my content'}
        </button>
      </form>
        </div>
    )
  }
  <div data-publication-preview data-original-content></div>
  <div data-feature-list data-original-content></div><button
    type="button"
    data-feature-more
    hidden>{vi ? 'Xem thêm' : 'More'}</button
  >
  {homeFeed && <><SignInDialogTemplate vi={vi} /><template data-post-comments-template><ApiComments vi={vi} epoch={1} contextPath={buildUrl('community/post/')} label={vi ? 'Bình luận bài viết' : 'Post comments'} inputId="post-comment-template-body" deferred /></template></>}
  {
    mode === 'editor' && (
        <div>
      <section>
          <h2>{vi ? 'Lịch sử revision' : 'Revision history'}</h2>
          <div data-publication-history data-original-content />
          <button type="button" data-history-more hidden>
            {vi ? 'Revision cũ hơn' : 'Older revisions'}
          </button>
      </section>
        </div>
    )
  }
  {
    mode === 'reader' && (
        <div>
      <div id="post-comments" data-object-discussion hidden>
        <ApiComments
          vi={vi}
          epoch={1}
          contextPath={buildUrl('community/post/')}
          deferred
        />
      </div>
        </div>
    )
  }
</section>
<script src="./entry.ts"></script>
<style>
  .publication-panel {
    max-width: 72ch;
    margin: 1.5rem 0;
  }
  form {
    display: grid;
    gap: 0.7rem;
    margin: 1rem 0;
  }
  label {
    display: grid;
    gap: 0.35rem;
  }
  input,
  textarea,
  select {
    padding: 0.6rem;
    border: 1px solid #94a3b8;
    border-radius: 0.35rem;
    width: 100%;
    background: white;
    color: #0f172a;
  }
  button {
    padding: 0.4rem 0.7rem;
    border: 1px solid #94a3b8;
    border-radius: 0.35rem;
    margin: 0.3rem 0.4rem 0.3rem 0;
    cursor: pointer;
  }
  [hidden] {
    display: none;
  }
  .toolbar {
    display: flex;
    gap: 0.6rem;
    align-items: center;
    flex-wrap: wrap;
  }
  :global(.publication-card) {
    border-bottom: 1px solid #cbd5e1;
    padding: 1rem 0;
  }
  :global(.publication-text) {
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }
  :global(.publication-player) {
    width: 100%;
    aspect-ratio: 16/9;
    border: 0;
  }
  :global([data-publication-preview] p),
  :global([data-publication-preview] pre) {
    white-space: pre-wrap;
    overflow-wrap: anywhere;
    margin: 0.6rem 0;
  }
</style>

<style is:global>
 .post-card-footer { align-items: center; gap: .2rem; flex-wrap: wrap; padding: .45rem .75rem; }
 .post-card-footer button { display: inline-flex; align-items: center; justify-content: center; gap: .35rem; border: 0; margin: 0; padding: .65rem .55rem; min-height: 44px; border-radius: .6rem; background: transparent; color: #52616b; font-size: .875rem; cursor: pointer; }
 .post-card-footer button:hover { background: #f0f5f2; }
 .post-card-footer button[aria-pressed="true"] { background: #e3f3ec; color: #17664d; font-weight: 700; }
 .post-card-footer button:disabled { opacity: .45; cursor: default; }
 .post-card-footer button:focus-visible { outline: 2px solid #0f766e; outline-offset: 1px; }
 .post-card-footer [data-reaction] > span:first-child { font-size: 1.3rem; line-height: 1; }
 .post-card-footer [data-post-comments] { margin-left: auto; }
 .post-inline-comments { border-top: 1px solid #edf1ef; padding: 0 1rem; }
 .post-inline-comments .api-comments { margin: 0; padding: 1rem 0; border: 0; }
 .post-interaction-status { margin: .4rem 1.25rem; font-size: .875rem; color: #64748b; }
 .post-interaction-status:empty { display: none; }
 .post-share-link { display: block; width: calc(100% - 2rem); margin: .5rem 1rem; padding: .5rem; }
 .social-post-card [hidden] { display: none !important; }
 @media(max-width:420px) { .post-card-footer { padding: .35rem .5rem!important; } .post-card-footer button { padding: .55rem .35rem; gap: .25rem; font-size: .8rem; } .post-card-footer [data-post-share] > span { display: none; } }
 .publication-panel[data-home-feed="true"]{max-width:48rem;margin:1rem 0}.publication-panel[data-home-feed="true"]>.toolbar{justify-content:flex-end}.publication-panel[data-home-feed="true"]>[data-feature-status]:empty{display:none}.publication-panel[data-home-feed="true"]>[data-feature-status]{font-size:.875rem;color:#64748b}.social-post-card{padding:0!important;margin:0 0 1.25rem;border:1px solid #dfe7e4!important;border-radius:1rem;overflow:hidden;background:#fff;box-shadow:0 3px 12px #0f172a05}.post-card-header{display:flex;gap:.75rem;align-items:center;padding:1.1rem 1.25rem .75rem}.post-card-header>img{width:44px;height:44px;object-fit:cover;border-radius:50%;flex-shrink:0}.post-card-header>div{flex:1;min-width:0}.post-card-header strong{font-size:1rem;color:#123f35}.post-card-header p{margin:.2rem 0 0;font-size:.8rem;color:#64748b}.post-card-header>button{font-size:.8rem;background:#f6f8f7;border:0;border-radius:2rem;padding:.4rem .7rem}.social-post-card>h3{padding:0 1.25rem;margin:.5rem 0}.post-card-body{padding:0 1.25rem 1rem;overflow-wrap:anywhere}.post-card-body p{white-space:pre-wrap;line-height:1.65;margin:.5rem 0}.post-social-details{color:#64748b;font-size:.875rem}.post-card-footer{border-top:1px solid #edf1ef;display:flex;padding:.75rem 1.25rem}.post-card-footer>a{display:block;text-decoration:none;font-weight:600;color:#35685b;font-size:.9rem;padding:.2rem .5rem}.post-photo-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:3px;border-radius:.75rem;overflow:hidden;margin-top:1rem}.post-photo-grid[data-count="1"]{grid-template-columns:minmax(0,1fr)}.post-photo{background:#eff4f1;min-height:8rem;display:grid;place-items:center;color:#64748b;font-size:.85rem}.post-photo>a{width:100%;height:100%}.post-photo img{display:block;width:100%;height:100%;aspect-ratio:1;object-fit:cover}.post-photo-grid[data-count="1"] img{aspect-ratio:4/3}.post-photo-grid[data-count="3"]>.post-photo:first-child{grid-row:span 2}.post-photo-grid[data-count="3"]>.post-photo:first-child img{aspect-ratio:auto}.post-photo button{padding:.5rem;border:1px solid #cbd5e1;border-radius:.5rem;background:white}.home-feed-title{font-size:1.15rem;font-weight:700;margin:0;color:#174b3c}@media(max-width:600px){.post-card-header{padding:1rem 1rem .65rem}.post-card-body{padding:0 1rem 1rem}.post-card-footer{padding:.65rem 1rem}.social-post-card>h3{padding:0 1rem}}
</style>
